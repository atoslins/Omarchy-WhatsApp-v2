#!/usr/bin/env bash
# Copy the working tree over an existing standalone install so QML, helper,
# and skill changes can be tried without the transactional installer.
# Only changed files are copied: Quickshell reloads the plugin once per
# changed QML file, so a full copy would reload it dozens of times.
set -euo pipefail

repo_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
user_home=${HOME:?HOME is required}
plugin_id=io.github.moizibnyousaf.omawhatsapp
plugin_target="$user_home/.config/omarchy/plugins/$plugin_id"
skill_target="$user_home/.agents/skills/omawhatsapp"
bin_target="$user_home/.local/bin"

command -v rsync >/dev/null || { echo "dev-sync: rsync is required." >&2; exit 1; }
if [[ ! -f $plugin_target/install-mode ]] \
    || [[ $(<"$plugin_target/install-mode") != standalone ]]; then
  echo "dev-sync: no standalone install at $plugin_target; run ./scripts/install once." >&2
  exit 1
fi

omarchy plugin validate "$repo_root" >/dev/null

# --inplace avoids the temp-file-and-rename dance, which the plugin watcher
# would see as extra events; the root copies of the notices are the ones the
# installer ships, so they are excluded here and compared separately.
changed=$(rsync -rci --inplace --delete \
  --exclude install-mode --exclude LICENSE --exclude THIRD_PARTY_NOTICES.md \
  "$repo_root/plugins/omawhatsapp/" "$plugin_target/" | awk '$1 ~ /^[<>*c]/ {print $2}')
for notice in LICENSE THIRD_PARTY_NOTICES.md; do
  if ! cmp -s "$repo_root/$notice" "$plugin_target/$notice"; then
    install -Dm644 "$repo_root/$notice" "$plugin_target/$notice"
    changed+=$'\n'"$notice"
  fi
done
if ! cmp -s "$repo_root/bin/omawhatsapp" "$bin_target/omawhatsapp"; then
  install -m755 "$repo_root/bin/omawhatsapp" "$bin_target/omawhatsapp"
  changed+=$'\n'"bin/omawhatsapp"
fi
if ! cmp -s "$repo_root/bin/omawhatsapp-mcp" "$bin_target/omawhatsapp-mcp"; then
  install -m755 "$repo_root/bin/omawhatsapp-mcp" "$bin_target/omawhatsapp-mcp"
  changed+=$'\n'"bin/omawhatsapp-mcp"
fi
if ! cmp -s "$repo_root/bin/omawhatsapp_assets.py" "$bin_target/omawhatsapp_assets.py"; then
  install -m644 "$repo_root/bin/omawhatsapp_assets.py" "$bin_target/omawhatsapp_assets.py"
  changed+=$'\n'"bin/omawhatsapp_assets.py"
fi
skill_changed=$(rsync -rci --inplace --delete "$repo_root/skills/omawhatsapp/" "$skill_target/" \
  | awk '$1 ~ /^[<>*c]/ {print "skill/" $2}')
[[ -z $skill_changed ]] || changed+=$'\n'"$skill_changed"

for unit in wacli-sync.service wacli-sync@.service; do
  if ! cmp -s "$repo_root/systemd/user/$unit" \
      "${XDG_CONFIG_HOME:-$user_home/.config}/systemd/user/$unit"; then
    echo "dev-sync: $unit differs from the installed unit; run ./scripts/install to apply it." >&2
  fi
done

changed=$(sed '/^$/d' <<<"$changed")
if [[ -z $changed ]]; then
  echo "dev-sync: installed copy already matches the working tree."
  exit 0
fi
echo "dev-sync: updated"
sed 's/^/  /' <<<"$changed"

# The shell's "Local plugin changed, reloading" keeps QML types it already
# compiled, so edited components keep running the old code until the shell
# restarts. Restart once when any plugin file changed (helpers and the skill
# are read fresh on every call and need no restart).
if grep -qvE '^(bin/|skill/)' <<<"$changed"; then
  if [[ ${DEV_SYNC_NO_RESTART:-0} == 1 ]]; then
    echo "dev-sync: plugin files changed; restart the shell to load them (omarchy restart shell)."
  else
    echo "dev-sync: restarting the Omarchy shell to load the new QML"
    omarchy-restart-shell >/dev/null
  fi
fi
